[push]
	default = simple
	recurseSubmodules = check
[user]
	name = Romaric JODIN
	email = jodin.romaric@gmail.com
[color]
	ui = true
[diff]
	submodule = log
	tool = meld
	colorMoved = zebra
	colorMovedWS = allow-indentation-change
[merge]
	tool = meld
[status]
	showUntrackedFiles = no
[alias]
	st = status -s
	stu = status -s -unormal
	lgs = log --format='%Cred%h %Cgreen(%ad) %C(yellow)<%an>%Creset %s %C(blue)%d%C(reset)' --date=short -16
	lgsf = log --format='%Cred%h %Cgreen(%ad) %C(yellow)<%an>%Creset %s %C(blue)%d%C(reset)' --date=short
	diffl = "!echo $1; git lgs ^HEAD $1 $2; echo HEAD; git lgs HEAD ^$1 $2"
	difflf = "!echo $1; git lgsf ^HEAD $1; echo HEAD; git lgsf HEAD ^$1"
	difff = diff --submodule=diff
	showf = show --submodule=diff
	pushf = push --recurse-submodules=on-demand
[pretty]
    unindented = "format:%C(auto,yellow)commit %H%C(auto)%d%C(reset)%nAuthor: %an <%ae>%nDate:   %ad%n--------%n%B%+N%n--------"
[format]
    pretty = unindented
[grep]
	lineNumber = true
[core]
	editor = emacs -nw
	pager = "test $(tput cols) -ge 150 && delta --side-by-side || delta"
[credential]
	helper = cache --timeout=300
[delta]
	wrap-right-symbol = \\
	wrap-left-symbol = \\
[init]
	defaultRefFormat = files
